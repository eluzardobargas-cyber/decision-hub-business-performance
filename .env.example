# PostgreSQL connection settings
DECISION_HUB_DB_USER=decision_hub_app
DECISION_HUB_DB_PASSWORD=your_password_here
DECISION_HUB_DB_HOST=localhost
DECISION_HUB_DB_PORT=5433
DECISION_HUB_DB_NAME=decision_hub

